<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>$(ModAssemblyName).Bootstrap</AssemblyName>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="sts2" HintPath="$(Sts2ApiSignatureRoot)\0.107.1\sts2.dll" Private="false"/>
        <EmbeddedResource Include="$(PayloadRoot)\0.107.1\$(ModAssemblyName).dll" LogicalName="payload.0.107.1.dll"/>
        <EmbeddedResource Include="$(PayloadRoot)\0.111.0\$(ModAssemblyName).dll" LogicalName="payload.0.111.0.dll"/>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>ModAssemblyName</_Parameter1>
            <_Parameter2>$(ModAssemblyName)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
